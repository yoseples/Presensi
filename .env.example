NODE_ENV=production
APP_NAME=Sistem Absensi Digital SMAN 1 Lhoksukon
APP_VERSION=2.0.0
APP_PUBLIC_DOMAIN=presensi.smansalhoksukon.sch.id
LICENSE_PRODUCT=presensi-smansa-pro

# Firebase Public Configuration (Client SDK Access)
FIREBASE_API_KEY=AIzaSyA_ExamplePublicWebApiKey_2026
FIREBASE_AUTH_DOMAIN=presensi-smansa-prod.firebaseapp.com
FIREBASE_DB_URL=https://presensi-smansa-prod-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=presensi-smansa-prod
FIREBASE_STORAGE_BUCKET=presensi-smansa-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ----------------------------------------------------------------------------
# 2. SECRET CONFIGURATION (STRICTLY SERVER-ONLY - NEVER IN FRONTEND)
# ----------------------------------------------------------------------------
LICENSE_SERVER_PORT=3001
ADMIN_API_KEY=adm_sec_smansa_master_2026_superkey_change_in_production
