# Path to Asymmetric RSA Keys (Relative to project root or Absolute path in Secret Manager)
RSA_PRIVATE_KEY_PATH=keys/license_private.key
RSA_PUBLIC_KEY_PATH=keys/license_public.key

# Database Storage Location
DATA_DIR=data
BACKUP_DIR=backups
