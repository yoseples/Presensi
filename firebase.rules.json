{
  "rules": {
    ".read": true,
    ".write": true,
    
    "developers": {
      ".indexOn": ["username", "nip", "role"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "siswa": {
      ".indexOn": ["nisn", "kelas", "nama"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "guru": {
      ".indexOn": ["username", "nip", "role", "kelas"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "tendik": {
      ".indexOn": ["username", "nip", "role"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "config": {
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "libur": {
      ".indexOn": ["tanggal"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "absensi": {
      ".indexOn": ["tanggal", "nisn", "username", "kelas", "status"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "login_logs": {
      ".indexOn": ["id", "userId", "username", "status", "timestamp"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    },
    
    "perizinan": {
      ".indexOn": ["tanggal", "nisn", "kelas", "statusPersetujuan"],
      ".validate": "newData.hasChildren() || newData.val() == false"
    }
  }
}
